@model ContractClaimsSystem.Models.Claim

<h2 style="color:pink;">Submit a New Claim</h2>

<form asp-action="SubmitClaim" method="post" enctype="multipart/form-data">
    <table style="width:100%; border-collapse:collapse;">
        <tr>
            <td><label>Name & Surname:</label></td>
            <td><input asp-for="claimantName" required /></td>
        </tr>
        <tr>
            <td><label>Hours Worked:</label></td>
            <td><input asp-for="hoursWorked" id="hoursWorked" type="number" step="0.1" required /></td>
        </tr>
        <tr>
            <td><label>Hourly Rate (R):</label></td>
            <td><input asp-for="hourRate" id="hourRate" type="number" step="0.01" required /></td>
        </tr>
        <tr>
            <td><label>Total Amount (R):</label></td>
            <td><input asp-for="totalAmount" id="totalAmount" readonly style="background-color:#ffe6f0;" /></td>
        </tr>
        <tr>
            <td><label>Description:</label></td>
            <td><textarea asp-for="claimDescription" rows="3" cols="30" required></textarea></td>
        </tr>
        <tr>
            <td><label>Upload Document:</label></td>
            <td><input type="file" name="supportingDocument" accept=".pdf,.docx,.xml" required /></td>
        </tr>
        <tr>
            <td colspan="2" style="text-align:center;">
                <button type="submit" style="background-color:pink; border:none; padding:10px;">Submit Claim</button>
            </td>
        </tr>
    </table>
</form>

@section Scripts {
    <script>
        const hoursInput = document.getElementById('hoursWorked');
        const rateInput = document.getElementById('hourRate');
        const totalInput = document.getElementById('totalAmount');

        function calculateTotal() {
            const hours = parseFloat(hoursInput.value) || 0;
            const rate = parseFloat(rateInput.value) || 0;
            totalInput.value = (hours * rate).toFixed(2);
        }

        hoursInput.addEventListener('input', calculateTotal);
        rateInput.addEventListener('input', calculateTotal);
    </script>
}
